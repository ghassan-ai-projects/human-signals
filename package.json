{
  "name": "human-signals",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Interactive visual model of human physiology — explore how the body communicates",
  "license": "MIT",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "npm run content:build && vite",
    "typecheck": "tsc --build --force",
    "lint": "eslint . --max-warnings 0 && node scripts/check-boundaries.ts",
    "content:validate": "node scripts/content-cli.ts validate --mode=preview --include-fixtures && node scripts/check-no-fabrication.ts",
    "content:build": "node scripts/content-cli.ts build --mode=preview --include-fixtures --verify-deterministic",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:budgets": "node scripts/check-budgets.ts",
    "build:preview": "npm run content:build && vite build --mode preview",
    "build": "node scripts/content-cli.ts build --mode=production && vite build --mode production",
    "preview": "vite preview --port 4173 --strictPort",
    "verify": "npm run typecheck && npm run lint && npm run content:validate && npm test",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-router-dom": "7.18.3",
    "zod": "4.6.2"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.63.0",
    "@react-three/fiber": "9.7.0",
    "@testing-library/dom": "10.4.1",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/node": "24.10.3",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "@types/three": "0.186.0",
    "@vitejs/plugin-react": "6.1.1",
    "@vitest/coverage-v8": "5.0.0",
    "eslint": "9.39.5",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.12.0",
    "jsdom": "30.0.1",
    "three": "0.186.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.70.0",
    "vite": "8.3.0",
    "vitest": "5.0.0"
  }
}
